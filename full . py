import streamlit as st
if 'page' not in st.session_state:
    st.session_state.page='home'
DXY=7

def gauge(t,s):
    c='#0f6' if s>=1 else '#f44' if s<=-1 else '#fc0'
    h='<div style="border:1px solid #222;'
    h+='border-radius:12px;padding:10px;'
    h+='border-left:4px solid '+c+'">'
    h+='<div>'+t+' '+str(s)+'</div></div>'
    return h

st.markdown(gauge('DXY AMBUSH',DXY),unsafe_allow_html=True)

forex=[('EURUSD',-7),('GBPUSD',-7),('USDJPY',7)]
forex+=[('AUDUSD',-7),('USDCHF',7),('USDCAD',6)]
commod=[('GOLD',-8),('SILVER',-7),('OIL',-3)]
indices=[('US30',-7),('NAS100',-7),('SPX500',-7)]
crypto=[('BTCUSD',-7),('ETHUSD',-7)]
cot=[['DXY','71','29','+3 Long','BULL']]
cot+=[['EURUSD','29','71','+4 Short','BEAR']]
cot+=[['GOLD','25','75','+5 Short','BEAR']]
cot+=[['BTCUSD','30','70','+2 Short','BEAR']]

retail=[['EURUSD','70','30','SELL']]
retail+=[['GOLD','75','25','SELL']]
retail+=[['BTCUSD','78','22','SELL']]
retail+=[['DXY','30','70','BUY']]

all_assets=['DXY','EURUSD','GBPUSD']
all_assets+=['USDJPY','AUDUSD','GOLD','BTCUSD']

if st.session_state.page=='home':
    if st.button('FOREX 6'):
        st.session_state.page='forex'
    if st.button('GOLD OIL'):
        st.session_state.page='gold'
    if st.button('INDICES'):
        st.session_state.page='indices'
    if st.button('CRYPTO'):
        st.session_state.page='crypto'
    if st.button('COT TABLE'):
        st.session_state.page='cot'
    if st.button('RETAIL'):
        st.session_state.page='retail'
    if st.button('AMBUSH-FINDER'):
        st.session_state.page='finder'
    if st.button('FUND SCHOOL'):
        st.session_state.page='learn_fund'
    if st.button('TECH SCHOOL'):
        st.session_state.page='learn_tech'
else:
    if st.button('BACK RADAR'):
        st.session_state.page='home'
        if st.session_state.page=='finder':
        st.subheader('AMBUSH-FINDER v2.8')
        ch=st.selectbox('Pick asset',all_assets)
        score=-7
        if 'DXY' in ch:
            score=7
        if 'USDJPY' in ch or 'USDCHF' in ch:
            score=7
        if 'USDCAD' in ch:
            score=6
        badge='BEARISH'
        if score>=2:
            badge='BULLISH'
        if score<=-6:
            badge='Very Bearish'
        if score>=6:
            badge='Very Bullish'
        col='green' if score>0 else 'red'
        st.markdown('<div style="color:'+col+';">Score '+str(score)+' '+badge+'</div>',unsafe_allow_html=True)
        st.write('WHY: DXY + COT + Retail + VIX all BEAR bias')

    if st.session_state.page=='forex':
        st.subheader('FOREX 6')
        for t,s in forex:
            st.markdown(gauge(t,s),unsafe_allow_html=True)

    if st.session_state.page=='gold':
        st.subheader('GOLD OIL')
        for t,s in commod:
            st.markdown(gauge(t,s),unsafe_allow_html=True)

    if st.session_state.page=='indices':
        for t,s in indices:
            st.markdown(gauge(t,s),unsafe_allow_html=True)

    if st.session_state.page=='crypto':
        for t,s in crypto:
            st.markdown(gauge(t,s),unsafe_allow_html=True)

    if st.session_state.page=='cot':
        st.subheader('COT TABLE')
        for r in cot:
            st.write(r)

    if st.session_state.page=='retail':
        st.subheader('RETAIL')
        for r in retail:
            st.write(r)
